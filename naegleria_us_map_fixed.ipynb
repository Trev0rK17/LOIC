# Imports and helpers
import sys, subprocess, pkgutil

def ensure(pkg, pip_name=None):
    if pkgutil.find_loader(pkg) is None:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet", pip_name or pkg])

for mod, pip in [
    ("pandas", "pandas"),
    ("plotly", "plotly"),
    ("requests", "requests"),
    ("bs4", "beautifulsoup4"),
    ("us", "us"),
]:
    ensure(mod, pip)

